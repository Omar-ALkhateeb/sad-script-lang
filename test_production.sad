// ١. قراءة ملف البيانات (students.csv) باستخدام الباندا
جدول = اقرأ_جدول("students.csv")

// ٢. حساب عمود المعدل لكل طالب
جدول["المعدل"] = (جدول["الرياضيات"] + جدول["العلوم"]) / ٢

اطبع("=== أفضل ٣ طلاب في الصف ===")
أفضل_الطلاب = جدول.حذف_الفارغ().رتب_قيم(حسب="المعدل"، تصاعدي=خطأ).أول(٣)
اطبع(أفضل_الطلاب)

معدل_الصف = قرب(متوسط(جدول["المعدل"])، ٢)
اطبع("\nالمعدل العام للصف: " + معدل_الصف)

// ٣. رسم بياني بالأعمدة بسطر واحد
جدول.ارسم_أعمدة("الاسم"، "المعدل"، العنوان="معدلات الطلاب النهائية")