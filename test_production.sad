// ١. تجربة الفاصلة العربية (،) ومعامل الانتماء (في / ليس في)
الطلاب = ["أحمد"، "سارة"، "علي"، "نور"]

اذا "سارة" في الطلاب {
    اطبع("✅ سارة مسجلة في القائمة!")
}

// ٢. تجربة تعديل متغير عام داخل دالة (Auto-Global) واستدعاء دالة معرفة لاحقاً
النقاط_الكلية = ٠

دالة اضف_مكافأة(قيمة) {
    النقاط_الكلية += حساب_المضاعف(قيمة)
}

دالة حساب_المضاعف(س) {
    ارجع س * ٢
}

اضف_مكافأة(١٥)
اطبع("النقاط الكلية بعد المكافأة: " + النقاط_الكلية)

// ٣. تجربة التسامح مع الهمزات (اول بدون همزة، اقرأ/جدول_بيانات)
بيانات = {
    "الاسم": ["أحمد"، "سارة"، "علي"، "نور"]،
    "الدرجة": [٨٨، ٩٦، ٧٥، ٩٢]
}
جدول = باندا.جدول_بيانات(بيانات)
افضل_طالبين = جدول.رتب_قيم(حسب="الدرجة"، تصاعدي=خطأ).اول(٢)
اطبع("\n=== أفضل طالبين ===")
اطبع(افضل_طالبين)

// ٤. تجربة حاول / التقط (Try / Catch)
حاول {
    نتيجة = ١٠ / ٠
} التقط خطأ_قسمة {
    اطبع("\nتم الإمساك بالخطأ بأمان داخل بلوك (حاول/التقط)!")
}

// ٥. توليد رسم بياني وحفظه كملف SVG يدعم العربية
جدول.ارسم_أعمدة("الاسم"، "الدرجة"، العنوان="درجات الطلاب")