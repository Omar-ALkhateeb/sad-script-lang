start: statement*

statement: assignment
         | aug_assignment
         | print_stmt
         | return_stmt
         | break_stmt
         | continue_stmt
         | if_stmt
         | repeat_stmt
         | for_range_stmt
         | for_in_stmt
         | while_stmt
         | func_def
         | try_stmt
         | expr_stmt

assignment: target "=" expr
aug_assignment: target AUG_OP expr
?target: IDENT                                      -> assign_var
       | atom "[" expr "]"                          -> assign_index
       | atom "." IDENT                             -> assign_attr

print_stmt: _PRINT "(" [arg_list] ")"
return_stmt: _RETURN [expr]
break_stmt: _BREAK
continue_stmt: _CONTINUE

if_stmt: _IF expr "{" block "}" elif_clause* [else_clause]
elif_clause: _ELIF expr "{" block "}"
else_clause: _ELSE "{" block "}"

repeat_stmt: _REPEAT expr _TIMES "{" block "}"
           | _REPEAT expr "{" block "}"
for_range_stmt: _FOR IDENT _FROM expr _TO expr "{" block "}"
for_in_stmt: _FOR IDENT _IN expr "{" block "}"
while_stmt: _WHILE expr "{" block "}"
func_def: _FUNC IDENT "(" [params] ")" "{" block "}"
try_stmt: _TRY "{" block "}" _CATCH [IDENT] "{" block "}"

params: param (_COMMA param)*
param: IDENT
     | IDENT "=" expr                               -> default_param

block: statement*
expr_stmt: expr

?expr: logic_or
?logic_or: logic_and
         | logic_or _OR logic_and                   -> bool_or
?logic_and: logic_not
          | logic_and _AND logic_not                -> bool_and
?logic_not: comparison
          | _NOT logic_not                          -> bool_not

?comparison: bitwise
           | comparison CMP_OP bitwise              -> compare
           | bitwise _IN bitwise                    -> in_op
           | bitwise _NOT _IN bitwise               -> not_in_op

?bitwise: sum
        | bitwise "&" sum                           -> bit_and
        | bitwise "|" sum                           -> bit_or
?sum: product
    | sum "+" product                               -> add
    | sum "-" product                               -> sub
?product: power
        | product "*" power                         -> mul
        | product "/" power                         -> div
        | product "//" power                        -> floordiv
        | product "%" power                         -> mod
?power: unary
      | atom "**" power                             -> pow_op
?unary: atom
      | "-" unary                                   -> neg
      | "+" unary                                   -> pos

?atom: NUMBER                                       -> number
     | STRING                                       -> string
     | _TRUE                                        -> bool_true
     | _FALSE                                       -> bool_false
     | _NONE                                        -> none_val
     | "[" [expr (_COMMA expr)*] "]"                -> array
     | "{" [kv_pair (_COMMA kv_pair)*] "}"          -> dict_literal
     | atom "." IDENT "(" [arg_list] ")"            -> method_call
     | atom "." IDENT                               -> attr_access
     | IDENT "(" [arg_list] ")"                     -> func_call
     | atom "[" slice_or_expr "]"                   -> index_access
     | IDENT                                        -> var
     | "(" expr ")"                                 -> parens

?slice_or_expr: expr
              | [expr] ":" [expr]                   -> slice_expr

kv_pair: expr ":" expr
arg_list: argument (_COMMA argument)*
?argument: expr
         | IDENT "=" expr                           -> kwarg

// --- Punctuation ---
_COMMA: "," | "،"

// --- Keywords (Priority .2 + word boundary so keywords beat IDENT without breaking names like 'وليد') ---
_PRINT.2: ("اطبع" | "إطبع" | "print") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_RETURN.2: ("ارجع" | "أرجع" | "إرجع" | "return") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_BREAK.2: ("توقف" | "اكسر" | "إكسر" | "break") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_CONTINUE.2: ("استمر" | "إستمر" | "اكمل" | "أكمل" | "continue") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_ELIF.2: ("والا_اذا" | "وإلا_إذا" | "والا_إذا" | "elif") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_IF.2: ("اذا" | "إذ" | "إذا" | "if") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_ELSE.2: ("والا" | "وإلا" | "else") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_REPEAT.2: ("كرر" | "repeat") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_TIMES.2: ("مرات" | "مرة" | "مره" | "times") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_FOR.2: ("لكل" | "for") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_FROM.2: ("من" | "from") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_TO.2: ("الى" | "إلى" | "to") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_IN.2: ("في" | "in") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_WHILE.2: ("طالما" | "while") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_FUNC.2: ("دالة" | "داله" | "function" | "def") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_TRY.2: ("حاول" | "try") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_CATCH.2: ("التقط" | "إلتقط" | "امسك" | "أمسك" | "except" | "catch") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_OR.2: ("او" | "أو" | "or") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_AND.2: ("و" | "and") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_NOT.2: ("ليس" | "not") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_TRUE.2: ("صحيح" | "صح" | "true" | "True") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_FALSE.2: ("خطأ" | "خطا" | "false" | "False") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/
_NONE.2: ("فارغ" | "لا_شيء" | "null" | "None") /(?![a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3])/

AUG_OP: "+=" | "-=" | "*=" | "/="
CMP_OP: "==" | "!=" | ">=" | "<=" | ">" | "<"
NUMBER: /[0-9٠-٩]+(\.[0-9٠-٩]+)?/
STRING: /"[^"]*"|'[^']*'/
IDENT: /[a-zA-Z_\u0621-\u064A\u0671-\u06D3][a-zA-Z0-9_\u0621-\u064A\u0660-\u0669\u0671-\u06D3]*/

COMMENT: "//" /[^\n]*/ | "#" /[^\n]*/
%ignore /[ \t\f\r\n;؛]+/
%ignore COMMENT